{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-proctor/agent-proctor/schemas/paperset.schema.json",
  "title": "Exam Paperset",
  "description": "试卷：试题集合 + 考场绑定 + 指标门禁（PRD 所称 suite）。",
  "type": "object",
  "required": ["name", "axis", "room", "items"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "axis": { "enum": ["A", "B", "C", "AB", "AC", "BC"] },
    "room": { "type": "string", "minLength": 1 },
    "matrix_env": { "type": "string" },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "pattern": "^[A-Z]+[A-Z0-9-]*$" }
    },
    "gates": {
      "type": "object",
      "description": "指标门禁。hosted 通道指标不得出现（PRD §5.2）。",
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "min": { "type": "number" },
          "max": { "type": "number" }
        }
      }
    }
  }
}
