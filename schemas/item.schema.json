{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-proctor/agent-proctor/schemas/item.schema.json",
  "title": "Exam Item",
  "description": "单道试题（PRD 所称 case）。id + rev 与内容绑定：改 stimulus/expect 必须升 rev。",
  "type": "object",
  "required": [
    "id",
    "rev",
    "axis",
    "status",
    "title",
    "intent",
    "freeze",
    "stimulus",
    "expect",
    "metrics",
    "execution"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "id": {
      "type": "string",
      "pattern": "^[A-Z]+[A-Z0-9-]*$",
      "description": "全局唯一试题号。"
    },
    "rev": { "type": "integer", "minimum": 1 },
    "axis": { "enum": ["A", "B", "C", "AB", "AC", "BC"] },
    "status": { "enum": ["active", "draft", "deprecated"] },
    "title": { "type": "string", "minLength": 1 },
    "owner": { "type": "string" },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "description": "可选。产品评测题库仅存放任务类型（如 coding / workspace）；不要写入 paired、plugin-off、plugin-on、effect。"
    },
    "intent": {
      "type": "object",
      "required": ["statement", "attribution_focus"],
      "additionalProperties": false,
      "properties": {
        "statement": { "type": "string", "minLength": 1 },
        "attribution_focus": { "$ref": "#/$defs/attribution" },
        "protocol_probes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "hosted：durable NDJSON 中期望出现的 Kind（设计 12）"
        },
        "effect_pair": {
          "type": "string",
          "minLength": 1,
          "description": "配对效果键：off/on 两侧相同，用于 compare 分差对齐（如 PAIRED-TASK-01）。缺省时可从题号 *-OFF/*-ON 推断。"
        }
      }
    },
    "freeze": { "type": "object" },
    "stimulus": {
      "type": "object",
      "required": ["kind", "ref"],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": ["event_sequence", "task_prompt", "tool_args", "hook_script", "cassette"]
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "description": "相对考卷库根的考材路径（materials/...）。"
        },
        "notes": { "type": "string" },
        "hosted_pass_token": {
          "type": "string",
          "minLength": 1,
          "description": "B-hosted 直播跑：stdout 须含该词（整词匹配，默认 ok）。"
        }
      }
    },
    "expect": {
      "type": "object",
      "required": ["oracles"],
      "additionalProperties": false,
      "properties": {
        "oracles": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/oracle" }
        }
      }
    },
    "metrics": {
      "type": "object",
      "required": ["primary"],
      "additionalProperties": false,
      "properties": {
        "primary": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "secondary": { "type": "array", "items": { "type": "string" } }
      }
    },
    "execution": {
      "type": "object",
      "required": ["deadline_ms", "requires_network"],
      "additionalProperties": false,
      "properties": {
        "deadline_ms": { "type": "integer", "exclusiveMinimum": 0 },
        "requires_network": { "type": "boolean" },
        "requires_durable_log": { "type": "boolean" },
        "repeats": { "type": "integer", "minimum": 1 }
      }
    },
    "change_log": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "deprecation": {
      "type": "object",
      "required": ["reason"],
      "properties": {
        "reason": { "type": "string", "minLength": 1 },
        "superseded_by": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "axis": { "const": "A" } }, "required": ["axis"] },
      "then": { "properties": { "freeze": { "$ref": "#/$defs/freezeA" } } },
      "else": { "properties": { "freeze": { "$ref": "#/$defs/freezeBC" } } }
    },
    {
      "if": { "properties": { "status": { "const": "deprecated" } }, "required": ["status"] },
      "then": { "required": ["deprecation"] }
    }
  ],
  "$defs": {
    "attribution": {
      "enum": ["PROTOCOL", "CONTEXT", "MODEL_SCHEMA", "MODEL_TASK", "TOOL", "HARNESS"]
    },
    "oracle": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "enum": [
            "event_fold",
            "event_subsequence",
            "state_predicate",
            "no_event",
            "tool_trace",
            "schema_obedience",
            "workspace_assert",
            "tool_result_equals",
            "tool_side_effect",
            "exit_code",
            "metric_threshold",
            "stdout_assert"
          ]
        },
        "id": { "type": "string" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "exit_code" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-exit-code" }
        },
        {
          "if": { "properties": { "type": { "const": "workspace_assert" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-workspace-assert" }
        },
        {
          "if": { "properties": { "type": { "const": "tool_side_effect" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-tool-side-effect" }
        },
        {
          "if": { "properties": { "type": { "const": "tool_result_equals" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-tool-result-equals" }
        },
        {
          "if": { "properties": { "type": { "const": "stdout_assert" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-stdout-assert" }
        },
        {
          "if": { "properties": { "type": { "const": "metric_threshold" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-metric-threshold" }
        },
        {
          "if": { "properties": { "type": { "const": "event_fold" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-event-fold" }
        },
        {
          "if": { "properties": { "type": { "const": "event_subsequence" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-event-subsequence" }
        },
        {
          "if": { "properties": { "type": { "const": "state_predicate" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-state-predicate" }
        },
        {
          "if": { "properties": { "type": { "const": "no_event" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-no-event" }
        },
        {
          "if": { "properties": { "type": { "const": "tool_trace" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-tool-trace" }
        },
        {
          "if": { "properties": { "type": { "const": "schema_obedience" } }, "required": ["type"] },
          "then": { "$ref": "#/$defs/oracle-schema-obedience" }
        }
      ]
    },
    "oracle-exit-code": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "exit_code" },
        "id": { "type": "string" },
        "equals": { "type": "number" }
      },
      "additionalProperties": false
    },
    "oracle-workspace-assert": {
      "type": "object",
      "required": ["type", "path"],
      "properties": {
        "type": { "const": "workspace_assert" },
        "id": { "type": "string" },
        "path": { "type": "string", "minLength": 1 },
        "file": { "type": "string", "minLength": 1 },
        "contains": { "type": "string" },
        "not_contains": { "type": "string" },
        "exists": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "oracle-tool-side-effect": {
      "type": "object",
      "required": ["type", "file"],
      "properties": {
        "type": { "const": "tool_side_effect" },
        "id": { "type": "string" },
        "file": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "contains": { "type": "string" }
      },
      "additionalProperties": false
    },
    "oracle-tool-result-equals": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "tool_result_equals" },
        "id": { "type": "string" },
        "equals": {},
        "expected": {}
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["equals"] },
        { "required": ["expected"] }
      ]
    },
    "oracle-stdout-assert": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": { "const": "stdout_assert" },
        "id": { "type": "string" },
        "contains": { "type": ["string", "array"] },
        "not_contains": { "type": ["string", "array"] },
        "contains_regex": { "type": ["string", "array"] },
        "not_contains_regex": { "type": ["string", "array"] },
        "regex_flags": { "type": "string" }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["contains"] },
        { "required": ["not_contains"] },
        { "required": ["contains_regex"] },
        { "required": ["not_contains_regex"] }
      ]
    },
    "oracle-metric-threshold": {
      "type": "object",
      "required": ["type", "metric"],
      "properties": {
        "type": { "const": "metric_threshold" },
        "id": { "type": "string" },
        "metric": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "min": { "type": "number" },
        "max": { "type": "number" }
      },
      "additionalProperties": false
    },
    "oracle-event-fold": {
      "type": "object",
      "required": ["type", "spec"],
      "properties": {
        "type": { "const": "event_fold" },
        "id": { "type": "string" },
        "spec": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "oracle-event-subsequence": {
      "type": "object",
      "required": ["type", "names"],
      "properties": {
        "type": { "const": "event_subsequence" },
        "id": { "type": "string" },
        "names": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "oracle-state-predicate": {
      "type": "object",
      "required": ["type", "expr"],
      "properties": {
        "type": { "const": "state_predicate" },
        "id": { "type": "string" },
        "expr": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "oracle-no-event": {
      "type": "object",
      "required": ["type", "names"],
      "properties": {
        "type": { "const": "no_event" },
        "id": { "type": "string" },
        "names": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "oracle-tool-trace": {
      "type": "object",
      "required": ["type", "must_call"],
      "properties": {
        "type": { "const": "tool_trace" },
        "id": { "type": "string" },
        "must_call": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "oracle-schema-obedience": {
      "type": "object",
      "required": ["type", "tool", "required_fields"],
      "properties": {
        "type": { "const": "schema_obedience" },
        "id": { "type": "string" },
        "tool": { "type": "string", "minLength": 1 },
        "required_fields": { "type": "array", "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "freezeA": {
      "type": "object",
      "required": ["layer", "model_driver"],
      "properties": {
        "layer": { "enum": ["L1", "L2", "L3"] },
        "model_driver": { "enum": ["none", "scripted", "as-recorded"] },
        "fold_entry": {
          "type": "string",
          "minLength": 1,
          "description": "逻辑名，对应 room.fold_entries 的键（非模块路径）。"
        },
        "event_schema": { "type": "string", "minLength": 1 },
        "session_id": { "type": "string", "minLength": 1 },
        "contract": { "type": "string", "minLength": 1 },
        "script": { "type": "string", "minLength": 1 },
        "cassette": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": { "properties": { "layer": { "const": "L1" } }, "required": ["layer"] },
          "then": {
            "required": ["fold_entry"],
            "properties": { "model_driver": { "const": "none" } },
            "not": {
              "anyOf": [
                { "required": ["contract"] },
                { "required": ["script"] },
                { "required": ["cassette"] }
              ]
            }
          }
        },
        {
          "if": { "properties": { "layer": { "const": "L2" } }, "required": ["layer"] },
          "then": {
            "required": ["contract", "script"],
            "properties": { "model_driver": { "const": "scripted" } }
          }
        },
        {
          "if": { "properties": { "layer": { "const": "L3" } }, "required": ["layer"] },
          "then": {
            "required": ["contract", "cassette"],
            "properties": { "model_driver": { "const": "as-recorded" } }
          }
        }
      ]
    },
    "freezeBC": {
      "type": "object",
      "required": ["model_driver", "model_id", "host_profile", "tool_profile", "prompt_template"],
      "additionalProperties": false,
      "properties": {
        "model_driver": { "enum": ["none", "scripted", "as-recorded", "live"] },
        "model_id": { "type": "string", "minLength": 1 },
        "host_profile": {
          "type": "string",
          "minLength": 1,
          "description": "绑定的考场（room）名。"
        },
        "tool_profile": { "type": "string", "minLength": 1 },
        "prompt_template": { "type": "string", "minLength": 1 },
        "channel": { "enum": ["direct", "hosted"] }
      }
    }
  }
}
