{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/agent-proctor/agent-proctor/schemas/environment.schema.json",
  "title": "EnvironmentProfile",
  "description": "V2.17 一键创建/重置测试环境的版本化配方（cases-v1）。",
  "type": "object",
  "required": ["environment_profile_id", "name", "lifecycle", "recipe"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "environment_profile_id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "name": { "type": "string", "minLength": 1 },
    "lifecycle": { "enum": ["draft", "active", "deprecated"] },
    "recipe": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "os": { "type": "string" },
        "architecture": { "type": "string" },
        "runtime": { "type": "string" },
        "host": { "type": "string" },
        "plugin": { "type": "string" },
        "node": { "type": "string" },
        "package_manager": { "type": "string" },
        "lockfile": { "type": "string" },
        "workspace_template": { "type": "string" },
        "data_seed": { "type": "string" },
        "network_policy": { "type": "string" },
        "isolation_profile": { "type": "string" },
        "host_command": { "type": "string" },
        "host_model": { "type": "string" },
        "host_agent": { "type": "string" },
        "managed_agents": {
          "type": "array",
          "items": { "type": "string" }
        },
        "host_plugin": { "type": "string" },
        "durable_log_glob": { "type": "string" },
        "kind": {
          "enum": ["fold", "fake-host", "cassette", "live-model", "hosted", "direct-tool"],
          "description": "环境类型（原 papers-v1 room.kind 迁移）。"
        },
        "model_driver": {
          "enum": ["none", "scripted", "as-recorded", "live"],
          "description": "模型驱动（原 papers-v1 room.model_driver 迁移）。"
        },
        "fold_entries": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["module", "export", "signature", "event_schema"],
            "additionalProperties": false,
            "properties": {
              "module": { "type": "string" },
              "export": { "type": "string" },
              "signature": { "enum": ["session_fold_v1", "pure_fold_v1"] },
              "event_schema": { "type": "string" },
              "resolve_root": { "enum": ["sut", "project"] },
              "normalize": { "enum": ["json_clone", "none"] }
            }
          },
          "description": "L1 fold 入口表（原 papers-v1 room.fold_entries 迁移）。"
        },
        "adapter": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "framework": { "type": "string" },
            "config": { "type": "string" },
            "repeats": { "type": "integer" },
            "hook_style": { "enum": ["demo-v1", "opencode-v1"] },
            "workspace": { "type": "string" },
            "skip_hook_dispatch": { "type": "boolean" }
          },
          "description": "L2/C 轴 adapter（原 papers-v1 room.adapter 迁移）。"
        },
        "sut": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": { "type": "string" },
            "root_env": { "type": "string" },
            "root_rel": { "type": ["string", "null"] }
          },
          "description": "SUT 根（原 papers-v1 room.sut 迁移）。"
        },
        "contract": { "type": "string" },
        "event_schema": { "type": "string" }
      }
    }
  }
}
