{
  "name": "hosted-wanxiangshu-v1",
  "kind": "hosted",
  "description": "真 OpenCode + 万象术 Plugin；采集 .wanxiangshu.ndjson 做归因。",
  "model_driver": "live",
  "network": true,
  "secrets": ["env-only"],
  "durable_log": "temp-workspace",
  "durable_log_glob": "**/.wanxiangshu.ndjson",
  "attribution_tree": "attribution-tree-v1",
  "host": {
    "name": "opencode",
    "version": "1.18.5",
    "command": "opencode",
    "model": "meituan/LongCat-2.0",
    "plugin": "papers/adapters/opencode-plugin-entry.mjs"
  }
}
