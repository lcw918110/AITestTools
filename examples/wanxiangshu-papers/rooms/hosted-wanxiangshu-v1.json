{
  "name": "hosted-wanxiangshu-v1",
  "kind": "hosted",
  "description": "真 OpenCode + 万象术 Plugin。0.8+ 耐久为 EventStore；.wanxiangshu.ndjson 不再当挂载健康信号。",
  "model_driver": "live",
  "network": true,
  "secrets": ["env-only"],
  "durable_log": "temp-workspace",
  "durable_log_glob": "**/.wanxiangshu.ndjson",
  "attribution_tree": "attribution-tree-v1",
  "host": {
    "name": "opencode",
    "version": "1.18.5",
    "command": "opencode",
    "model": "meituan/LongCat-2.0",
    "plugin": "dist/Infrastructure/OpenCode/Plugin/Plugin.js"
  }
}
