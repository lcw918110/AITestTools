{
  "name": "hosted-plugin-alt-v1",
  "kind": "hosted",
  "description": "实验 2：真 OpenCode + 万象术，模型相对 hosted-plugin-v1 只改 host.model（默认 agnes/agnes-2.0-flash）。受管 agent / 隔离 / EventStore 与 plugin-v1 同构。",
  "model_driver": "live",
  "network": true,
  "workspace": "isolated",
  "secrets": ["env-only"],
  "durable_log": "event-store",
  "durable_log_glob": "**/.git/refs/wanxiang/store",
  "attribution_tree": "attribution-tree-v1",
  "host": {
    "name": "opencode",
    "version": "1.18.5",
    "command": "opencode",
    "model": "agnes/agnes-2.0-flash",
    "agent": "fast-coder",
    "managed_agents": [
      "fast-manager",
      "deep-manager",
      "fast-coder",
      "deep-coder",
      "fast-inspector",
      "deep-inspector",
      "fast-devops",
      "deep-devops",
      "fast-browser",
      "deep-browser",
      "fast-inquiry",
      "deep-inquiry",
      "fast-reviewer",
      "deep-reviewer",
      "fast-orchestrator",
      "deep-orchestrator",
      "fast-distiller",
      "deep-distiller",
      "fast-blogger",
      "deep-blogger"
    ],
    "plugin": "dist/OpenCode/Plugin/Plugin.js"
  }
}
