{
  "name": "hosted-plugin-v1",
  "kind": "hosted",
  "description": "真 OpenCode + 万象术 Plugin（配对 treatment）。plugin 相对 SUT_ROOT。耐久为 EventStore（refs/wanxiang/store）。",
  "model_driver": "live",
  "network": true,
  "workspace": "isolated",
  "secrets": [
    "env-only"
  ],
  "durable_log": "event-store",
  "durable_log_glob": "**/.git/refs/wanxiang/store",
  "attribution_tree": "attribution-tree-v1",
  "host": {
    "name": "opencode",
    "version": "1.18.5",
    "command": "opencode",
    "model": "wave-anthropic/claude-sonnet-5",
    "agent": "fast-coder",
    "managed_agents": [
      "fast-manager",
      "deep-manager",
      "fast-coder",
      "deep-coder",
      "fast-inspector",
      "deep-inspector",
      "fast-devops",
      "deep-devops",
      "fast-browser",
      "deep-browser",
      "fast-inquiry",
      "deep-inquiry",
      "fast-reviewer",
      "deep-reviewer",
      "fast-orchestrator",
      "deep-orchestrator",
      "fast-distiller",
      "deep-distiller",
      "fast-blogger",
      "deep-blogger"
    ],
    "plugin": "dist/OpenCode/Plugin/Plugin.js"
  }
}
