{
  "name": "hosted-model-alt-v1",
  "kind": "hosted",
  "description": "实验 2：同题换模型、无插件（相对 hosted-plain-v1 只改 host.model；默认 agnes/agnes-2.0-flash）。受管 agent 与 plain 同构，避免对照混入 agent 配置差。不要用 PROCTOR_HOSTED_MODEL 覆盖（会让 model_source 不再是 room）。",
  "model_driver": "live",
  "network": true,
  "workspace": "isolated",
  "secrets": [
    "env-only"
  ],
  "durable_log": "temp-workspace",
  "attribution_tree": "attribution-tree-v1",
  "host": {
    "name": "opencode",
    "version": "1.18.5",
    "command": "opencode",
    "model": "agnes/agnes-2.0-flash",
    "agent": "fast-coder",
    "managed_agents": [
      "fast-manager",
      "deep-manager",
      "fast-coder",
      "deep-coder",
      "fast-inspector",
      "deep-inspector",
      "fast-devops",
      "deep-devops",
      "fast-browser",
      "deep-browser",
      "fast-inquiry",
      "deep-inquiry",
      "fast-reviewer",
      "deep-reviewer",
      "fast-orchestrator",
      "deep-orchestrator",
      "fast-distiller",
      "deep-distiller",
      "fast-blogger",
      "deep-blogger"
    ]
  }
}
