# 复制为 .env 后填写。切勿把真实密钥提交进 git。
LONGCAT_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.longcat.chat/openai

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

PROCTOR_PROMPTFOO_LIVE=0
# CI 默认 fixture；真 spike：
#   PROCTOR_PROMPTFOO_LIVE=1 MATRIX_SUBJECTS=LongCat-2.0,deepseek-v4-flash
MATRIX_SUBJECTS=fixture-a,fixture-b

# B-hosted：显式指定 OpenCode 模型（provider/model）；全局默认已改 meituan/LongCat-2.0
# 注意：OpenCode meituan.apiKey 需与可用额度的 LongCat key 一致（可从项目 .env 同步）
PROCTOR_HOSTED_MODEL=meituan/LongCat-2.0
PROCTOR_HOSTED_AGENT=

# 万象术 L1 考卷（examples/wanxiangshu-papers）
# SUT_ROOT=/absolute/path/to/wanxiangshu
